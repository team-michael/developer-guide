{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Notifly Docs",
  "theme": "mint",
   "colors": {
    "primary": "#0144CD",
    "light": "#3F7BFF"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Welcome",
        "groups": [
          {
            "group": "시작하기 전에",
            "expanded": true,
            "pages": [
              "index"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "시작하기",
            "expanded": true,
            "pages": [
              "sdk/index"
            ]
          },
          {
            "group": "유저 가이드",
            "expanded": false,
            "pages": [
              "sdk/firebase-integration",
              { 
              "group": "모바일용 SDK",
              "expanded": false,
              "pages": [
                {
                  "group": "기본 연동하기",
                  "pages": [
                    "sdk/android-sdk",
                    "sdk/ios-sdk",
                    "sdk/react-native-sdk",
                    "sdk/flutter-sdk"
                 ]
                },
                {
              "group": "심화 연동하기",
              "expanded": false,
              "pages": [
                "advanced/index",
                "advanced/push-notification-icon",
                "advanced/push-notification-consent",
                "advanced/push-notification-click-events",
                "advanced/push-notification-interceptor",
                "advanced/inapp-popup-event-listener",
                "advanced/rich-push-notification",
                "advanced/webview"
              ]
              } 
              ]
              },
              {
                  "group": "웹용 SDK",
                  "pages": [
                    "sdk/javascript-sdk",
                    "sdk/google-tag-manager"
                 ]
              },
              "integration-test"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.yaml",
        "groups": [
          {
            "group": "시작하기",
            "pages":[
              "api-reference/getting-started", 
              "api-reference/error" 
            ]
          },
          {
            "group": "인증",
            "pages": [
              "POST /authenticate"
            ]
          },
          {
            "group": "이벤트 & 사용자",
            "pages": [
              "POST /track-event",
              "POST /set-user-properties",
              "DELETE /users"
            ]
          },
          {
            "group": "캠페인",
            "pages": [
              "POST /projects/{projectId}/campaigns/{campaignId}/send",
              "POST /projects/{projectId}/user-journeys/{userJourneyId}/enter"
            ]
          },
          {
            "group": "메시징",
            "pages": [
              "POST /messages/text-message",
              "POST /messages/kakao-alimtalk",
              "POST /messages/kakao-friendtalk"
            ]
          },
          {
            "group": "메시징 관리",
            "pages": [
              {
                "group": "카카오 알림톡 템플릿",
                "pages": [
                  "GET /projects/{projectId}/messages/kakao-alimtalk/templates",
                  "POST /projects/{projectId}/messages/kakao-alimtalk/templates",
                  "PUT /projects/{projectId}/messages/kakao-alimtalk/templates/{templateCode}",
                  "DELETE /projects/{projectId}/messages/kakao-alimtalk/templates/{templateCode}"
                ]
              },
              {
                "group": "080 수신 거부 서비스",
                "pages": [
                  "GET /projects/{projectId}/messages/text-message/blockservice/recipients",
                  "POST /projects/{projectId}/messages/text-message/blockservice/recipients",
                  "DELETE /projects/{projectId}/messages/text-message/blockservice/recipients/removes"
                ]
              }
            ]
          },
          {
            "group": "내보내기 & 분석",
            "pages": [
              {
                "group": "메시지 이벤트 데이터 내보내기",
                "pages": [
                  "POST /projects/{projectId}/campaign-event-data/exports",
                  "GET /projects/{projectId}/campaign-event-data/exports/{exportId}/result"
                ]
              },
              "POST /v1/projects/{projectId}/statistics",
              "GET /projects/{projectId}/campaigns/{campaignId}/stats"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/notifly.png",
    "dark": "/images/notifly.png"
  }
}